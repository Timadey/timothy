APP_NAME=Timadey
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=timadey
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Production (Docker) overrides these via Docker ENV / Coolify:
#   CACHE_STORE=redis, SESSION_DRIVER=redis, INERTIA_SSR_ENABLED=true
# Required Coolify env vars for production: REDIS_HOST (redis service name),
# REDIS_PASSWORD (if the Redis service has one). Optional: REDIS_PORT (6379).
# Alternative: REDIS_URL=redis://:pass@host:6379 as a single var (overrides the
# ones above). Omit the URL path so REDIS_DB / REDIS_CACHE_DB still apply.
INERTIA_SSR_ENABLED=false
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

ASK_TO=hi@timothyadeleke.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
ADMIN_EMAIL=owner@timadey.test
ADMIN_PASSWORD=change-me-in-production

# AI SEO suggestions (admin "Suggest from content" button). All optional —
# with nothing set, the button uses instant local rules and never calls an API.
# Provider preset: openai | cohere | nvidia; or set LLM_BASE_URL for any
# OpenAI-compatible endpoint (OpenRouter, Groq, Ollama, ...).
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=10
# FILESYSTEM_DISK=public
